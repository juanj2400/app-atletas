# Copia este archivo como ".env" (sin .example) y rellena tus valores.
# Los encuentras en Supabase: Project Settings > API (o "API Keys").
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La clave PÚBLICA ("Publishable key", o "anon" en proyectos antiguos).
# NUNCA pongas aquí la service_role / secret key.
VITE_SUPABASE_KEY=tu_clave_publica
