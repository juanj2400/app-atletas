@@ -0,0 +1,34 @@
+// =====================================================================
+// src/lib/identidadLocal.js — recuerda QUIÉN es el usuario (perfil mínimo) para poder abrir la
+// app sin internet. Es un dato chico y sincrónico, por eso va en localStorage (el resto del
+// offline vive en IndexedDB, ver almacenLocal.js).
+//
+// No es una credencial: no guarda contraseñas ni tokens. Solo se usa si el navegador conserva
+// además la sesión de Supabase (hayTokenGuardado), y se borra al cerrar sesión.
+// =====================================================================
+const CLAVE = 'myprogress:identidad'
+
+export function guardarIdentidad(perfil) {
+  try { localStorage.setItem(CLAVE, JSON.stringify({ perfil, guardadoEn: Date.now() })) } catch { /* lleno o bloqueado */ }
+}
+
+export function leerIdentidad() {
+  try {
+    const crudo = localStorage.getItem(CLAVE)
+    const dato = crudo ? JSON.parse(crudo) : null
+    return dato?.perfil?.id ? dato : null
+  } catch { return null }
+}
+
+export function borrarIdentidad() {
+  try { localStorage.removeItem(CLAVE) } catch { /* nada */ }
+}
+
+// supabase-js guarda su sesión en localStorage como "sb-<proyecto>-auth-token". Si sigue ahí
+// es que el usuario NO cerró sesión y el servidor no la invalidó (un error de red no la borra).
+export function hayTokenGuardado() {
+  try {
+    const proyecto = new URL(import.meta.env.VITE_SUPABASE_URL).hostname.split('.')[0]
+    return Boolean(localStorage.getItem(`sb-${proyecto}-auth-token`))
+  } catch { return false }
+}
diff --git a/src/lib/useCola.js b/src/lib/useCola.js
new file mode 100644
index 0000000..659c06a
--- /dev/null
+++ b/src/lib/useCola.js
@@ -0,0 +1,56 @@
+// =====================================================================
+// src/lib/useCola.js — hooks de la cola offline.
+//
+//   useCola(userId)          -> { pendientes, errores, primerError, sincronizando, subidos }
+//                               `subidos` sube de número cada vez que se sube algo: úsalo como
+//                               dependencia de un useEffect para recargar la pantalla.
+//   useSincronizacion(userId)-> arranca la subida automática (al abrir la app, al volver el
+//                               internet, al volver a la app y cada 30 s mientras haya pendientes).
+// =====================================================================
+import { useCallback, useEffect, useState } from 'react'
+import { enLinea } from './conexion'
+import { estaSincronizando, resumenCola, sincronizarCola, suscribirCola } from './colaOffline'
+
+const VACIO = { pendientes: 0, errores: 0, primerError: null }
+
+export function useCola(userId) {
+  const [resumen, setResumen] = useState(VACIO)
+  const [sincronizando, setSincronizando] = useState(estaSincronizando())
+  const [subidos, setSubidos] = useState(0)
+
+  const refrescar = useCallback(() => {
+    resumenCola(userId).then(setResumen)
+  }, [userId])
+
+  useEffect(() => {
+    refrescar()
+    return suscribirCola((evento) => {
+      if (evento.tipo === 'inicio') setSincronizando(true)
+      if (evento.tipo === 'fin') {
+        setSincronizando(false)
+        if (evento.subidos > 0) setSubidos((n) => n + 1)
+      }
+      refrescar()
+    })
+  }, [refrescar])
+
+  return { ...resumen, sincronizando, subidos }
+}
+
+const CADA_CUANTO_MS = 30 * 1000
+
+export function useSincronizacion(userId) {
+  useEffect(() => {
+    const intentar = () => { if (enLinea()) sincronizarCola(userId) }
+    intentar() // al abrir la app: lo que quedó pendiente de la vez anterior
+    window.addEventListener('online', intentar)
+    const alVolver = () => { if (document.visibilityState === 'visible') intentar() }
+    document.addEventListener('visibilitychange', alVolver)
+    const intervalo = setInterval(intentar, CADA_CUANTO_MS) // reintento si la señal volvió sin avisar
+    return () => {
+      window.removeEventListener('online', intentar)
+      document.removeEventListener('visibilitychange', alVolver)
+      clearInterval(intervalo)
+    }
+  }, [userId])
+}
